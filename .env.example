# Valeurs publiques disponibles dans Settings > API de votre projet Supabase.
# Ne placez jamais SUPABASE_SERVICE_ROLE_KEY dans ce fichier ou dans Vite.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-publique-anon

# Optionnel : réservé aux appels HTTP externes. L’application utilise Supabase
# directement et ne nécessite pas d’API Express.
VITE_API_URL=
